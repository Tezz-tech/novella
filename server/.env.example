# ---- Server environment (copy to server/.env and fill in) ----
# Never commit real values. Keep this file in sync with CLAUDE.md.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/novelle-tech
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CURRENCY=NGN

# Paystack (test keys first: sk_test_... / pk_test_...)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Business Cloud API (Meta). Customers and the owner get order messages here.
# Templates must be approved in Meta Business Manager first (see docs/whatsapp-templates.md).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
# Owner number that receives an alert for every paid order (international, e.g. 2348012345678)
OWNER_WHATSAPP_NUMBER=

# Seed owner account (used by `npm run seed`)
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-now
